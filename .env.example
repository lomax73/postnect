# Copiare in .env e valorizzare. Non committare mai .env.

DJANGO_SECRET_KEY=
# In produzione DEVE restare false. Metti true solo in locale.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Token per la API interna di gestione utenti (accounts/), usata dal
# Portale — raggiungibile solo da localhost (regola Nginx), vedi deploy/README.md.
# Generare con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# Anagrafica clienti condivisa (nel Portale, app clienti/). PORTAL_API_TOKEN
# deve avere lo stesso valore di INTERNAL_API_TOKEN nel .env del Portale.
# PORTAL_INTERNAL_BASE_URL è l'URL loopback del Portale (es. https://127.0.0.1:8443
# in produzione), non l'URL pubblico.
PORTAL_INTERNAL_BASE_URL=
PORTAL_API_TOKEN=
PORTAL_PUBLIC_URL=
# Certificato self-signed del Portale, per verificare davvero la connessione
# TLS a PORTAL_INTERNAL_BASE_URL invece di disattivare la verifica. In
# produzione: /etc/ssl/portal/selfsigned.crt. Vuoto in locale.
PORTAL_INTERNAL_CA_CERT=

# Cifratura a riposo dell'access_token delle Destinazioni (Fernet). Generare con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# Celery — Redis condiviso con le altre app sulla stessa VPS, db separato
# per non interferire con le loro code. Vedi struttura_app_fbo.md per
# l'allocazione nota (verificare comunque sul VPS prima del primo deploy).
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3
